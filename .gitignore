.env
*.pyc
__pycache__/
.venv/
.tmp/
backend/uploads/
backend/workspace/
workspace/
*.log
.workbuddy/
~$*

# 开发模式下设置面板会把配置写到这里，里面有 API key
backend/config.json

# 打包产物
build/
dist/
*.spec.bak

# 评测产物与本地凭据（不入库）
eval/*/results/
eval/*/.env.local

# 完整数据集不入库（含商业数据库导出内容，仅本地保留）
# 仓库内公开的是随机抽样的演示样本 testdata.dta
testdata_full.dta
*.dta.bak

# 云端/代理本地数据（SQLite、产物、代理令牌、代理存档的 .dta）
cloud_data/
agent_data/

# Git Bash 下 2>nul 会生成字面文件 nul（Windows 保留设备名，删不掉），永不入库
nul

