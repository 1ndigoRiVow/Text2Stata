{
    "ols_basic": {
        "name": "基础 OLS 回归",
        "description": "最基础的稳健标准误 OLS 回归，适合快速基准分析。",
        "file_path": "regress/ols.do",
        "required_globals": ["y", "x"],
        "optional_globals": ["controls"],
        "output_files": ["ols_result.rtf"]
    },

    "ols_full": {
        "name": "完整 OLS 诊断回归",
        "description": "依次输出基准模型、控制变量模型、稳健标准误模型，并附带 VIF、异方差检验、残差预测和拟合值图。",
        "file_path": "regress/ols_full.do",
        "required_globals": ["y", "x"],
        "optional_globals": ["controls"],
        "output_files": ["ols_full_result.rtf", "ols_fit.png"]
    },

    "logit_binary": {
        "name": "二元因变量 Logit 回归",
        "description": "适用于 0/1 因变量，输出稳健标准误、边际效应和预测概率。",
        "file_path": "regress/logit.do",
        "required_globals": ["y", "x"],
        "optional_globals": ["controls"],
        "output_files": ["logit_result.rtf"]
    },

    "descriptive_stats": {
        "name": "描述性统计",
        "description": "输出核心变量的样本量、均值、标准差、分位数、最小值和最大值。",
        "file_path": "stats/descriptive.do",
        "required_globals": ["y", "x"],
        "optional_globals": ["controls"],
        "output_files": ["descriptive_stats.csv"]
    },

    "correlation_matrix": {
        "name": "相关系数矩阵",
        "description": "计算变量相关系数、显著性水平，并导出相关矩阵。",
        "file_path": "stats/correlation.do",
        "required_globals": ["y", "x"],
        "optional_globals": ["controls"],
        "output_files": ["correlation_matrix.rtf"]
    },

    "data_quality_report": {
        "name": "数据质量检查",
        "description": "检查关键变量缺失值、重复值、异常分布和基本描述统计。",
        "file_path": "diagnostics/data_quality.do",
        "required_globals": ["y", "x"],
        "optional_globals": ["controls", "id", "time"],
        "output_files": ["data_quality_report.txt"]
    },

    "robust_cluster": {
        "name": "聚类稳健标准误回归",
        "description": "在存在个体变量时聚类到个体层面；没有个体变量时回退到普通稳健标准误。",
        "file_path": "robust/cluster_robust.do",
        "required_globals": ["y", "x"],
        "optional_globals": ["controls", "id"],
        "output_files": ["cluster_robust_result.rtf"]
    },

    "fe": {
        "name": "固定效应模型",
        "description": "面板固定效应模型，适合已经指定 id 和 time 的面板数据。",
        "file_path": "regress/fe.do",
        "required_globals": ["y", "x", "id", "time"],
        "optional_globals": ["controls"],
        "output_files": ["fe_result.rtf"]
    },

    "hdfe": {
        "name": "双向固定效应模型，聚类到个体的稳健误",
        "description": "使用 reghdfe 吸收个体和时间固定效应，并聚类到个体层面。",
        "file_path": "regress/hdfe.do",
        "required_globals": ["y", "x", "id", "time"],
        "optional_globals": ["controls"],
        "output_files": ["hdfe_result.rtf"]
    },

    "panel_compare": {
        "name": "面板模型对比",
        "description": "同时估计 Pooled OLS、固定效应、随机效应和双向固定效应，便于横向比较。",
        "file_path": "panel/compare_models.do",
        "required_globals": ["y", "x", "id", "time"],
        "optional_globals": ["controls"],
        "output_files": ["panel_compare_result.rtf"]
    },

    "first_difference": {
        "name": "一阶差分模型",
        "description": "对因变量、核心解释变量和控制变量做一阶差分后回归，适合处理不随时间变化的个体异质性。",
        "file_path": "panel/first_difference.do",
        "required_globals": ["y", "x", "id", "time"],
        "optional_globals": ["controls"],
        "output_files": ["first_difference_result.rtf"]
    },

    "did_basic": {
        "name": "基础双重差分 DID",
        "description": "将 $x 视为已经构造好的 treat_post 等 DID 交互项，吸收个体和时间固定效应，并聚类到个体层面。",
        "file_path": "causal/did_basic.do",
        "required_globals": ["y", "x", "id", "time"],
        "optional_globals": ["controls"],
        "output_files": ["did_basic_result.rtf"]
    },

    "hausman": {
        "name": "豪斯曼检验，检验是否使用固定效应还是随机效应",
        "description": "估计 RE 与 FE，并执行 Hausman 检验。",
        "file_path": "regress/hausman.do",
        "required_globals": ["y", "x", "id", "time"],
        "optional_globals": ["controls"],
        "output_files": ["hausman.rtf"]
    }
}
