# 复制成 cloud.env 再填值。cloud.env 已被 .gitignore 挡住。

# ---- 必填 ----

# 你的域名（Caddy 用它申请证书；agent 上传 CORS 白名单也要填它）
T2S_DOMAIN=stata.example.com

# ---- 二选一：站点大模型密钥（留空 = 站点不开自带模型，用户只能 BYOK）----
# 注意：这是「站点密钥」，会计入用户配额与站点预算；
# 建议在中转站单独建一个低额度令牌给服务器用，与个人 key 分开。

# T2S_LLM_API_KEY=sk-...

# ---- 可选：站点预算（只管站点密钥；BYOK 用户自己承担）----

# 每百万 token 单价（元）。不填则金额算不出，预算退化为按 token 计。
# T2S_LLM_PRICE_PER_MTOK=4

# 月度预算（元）。用尽返回 503 并提示改用 BYOK。
# T2S_SITE_BUDGET_CNY=50

# ---- 可选：配额调参（默认值见 cloud/quota.py）----

# 每用户每日调用上限（站点密钥模式）
# T2S_DAILY_CALLS=50

# 每用户每分钟调用上限（突发限流，两种模式都管）
# T2S_BURST_PER_MINUTE=10

# ---- 可选：LLM 基础地址（默认中转站地址见 backend/core/config.py）----
# T2S_LLM_API_URL=https://your-relay.example.com/v1/chat/completions
